# コピーして .env.local を作成して使う（.env* は .gitignore 済み。このファイルのみ追跡）
# 秘密情報は NEXT_PUBLIC_ を付けない（付けるとブラウザに露出する）

# GCS 公開 JSON のベース URL（省略時は本番バケット）
GCS_BASE_URL=https://storage.googleapis.com/vtuber-335811.appspot.com

# 今後サーバー側（Route Handler 等）でのみ使う秘密情報の置き場所の例
# YOUTUBE_API_KEY=

# 正規 URL（canonical / sitemap / JSON-LD 用）。Vercel では未設定でも本番ドメインを自動使用
# SITE_URL=https://example.com
